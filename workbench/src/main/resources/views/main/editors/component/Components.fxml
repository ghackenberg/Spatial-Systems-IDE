<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns:fx="de.tum.imomesa" fx:controller="de.tum.imomesa.workbench.controllers.main.editors.component.ComponentsController">
	<top>
		<ToolBar>
			<items>
				<Button fx:id="buttonCreateComponent" text="Create component" onAction="#createComponent">
					<graphic>
						<ImageView fitWidth="16" fitHeight="16">
							<image>
								<Image url="icons/actions/add.png"/>
							</image>
						</ImageView>
					</graphic>
				</Button>
				<Button fx:id="buttonCreatePort" text="Create component" onAction="#createPort">
					<graphic>
						<ImageView fitWidth="16" fitHeight="16">
							<image>
								<Image url="icons/actions/add.png"/>
							</image>
						</ImageView>
					</graphic>
				</Button>
				<Button fx:id="buttonRemoveComponent" text="Remove component" onAction="#removeComponent">
					<graphic>
						<ImageView fitWidth="16" fitHeight="16">
							<image>
								<Image url="icons/actions/delete.png"/>
							</image>
						</ImageView>
					</graphic>
				</Button>
				<Button fx:id="buttonRemovePort" text="Remove port" onAction="#removePort">
					<graphic>
						<ImageView fitWidth="16" fitHeight="16">
							<image>
								<Image url="icons/actions/delete.png"/>
							</image>
						</ImageView>
					</graphic>
				</Button>
				<Button fx:id="buttonRemoveChannel" text="Remove channel" onAction="#removeChannel">
					<graphic>
						<ImageView fitWidth="16" fitHeight="16">
							<image>
								<Image url="icons/actions/delete.png"/>
							</image>
						</ImageView>
					</graphic>
				</Button>
			</items>
		</ToolBar>
	</top>
	<center>
		<Pane fx:id="pane" />
	</center>
</BorderPane>