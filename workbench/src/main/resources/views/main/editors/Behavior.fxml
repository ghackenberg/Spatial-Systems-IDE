<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns:fx="de.tum.imomesa" fx:controller="de.tum.imomesa.workbench.controllers.main.editors.BehaviorController">
	<top>
		<ToolBar>
			<items>
				<Button fx:id="buttonSetInitialState" text="Set initial state" onAction="#setInitialState">
					<graphic>
						<ImageView fitWidth="16" fitHeight="16">
							<image>
								<Image url="icons/actions/set.png"/>
							</image>
						</ImageView>
					</graphic>
				</Button>
				<Button fx:id="buttonRemoveState" text="Remove state" onAction="#removeState">
					<graphic>
						<ImageView fitWidth="16" fitHeight="16">
							<image>
								<Image url="icons/actions/delete.png"/>
							</image>
						</ImageView>
					</graphic>
				</Button>
				<Button fx:id="buttonRemoveTransition" text="Remove transition" onAction="#removeTransition">
					<graphic>
						<ImageView fitWidth="16" fitHeight="16">
							<image>
								<Image url="icons/actions/delete.png"/>
							</image>
						</ImageView>
					</graphic>
				</Button>
			</items>
		</ToolBar>
	</top>
	<center>
		<Pane fx:id="pane" />
	</center>
</BorderPane>